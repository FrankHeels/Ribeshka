# Copy to .env.test and replace this password. Never add application/Gmail secrets.
FISHSITE_TEST_DB_HOST=127.0.0.1
FISHSITE_TEST_DB_PORT=15432
FISHSITE_TEST_DB_USER=fishsite_tester
FISHSITE_TEST_DB_PASSWORD=replace-with-a-local-test-password
# postgres is only the maintenance DB. Django creates/drops test_fishsite.
FISHSITE_TEST_DB_NAME=postgres
