# Copy this file to .env inside the VM and replace the placeholder secrets.
POSTGRES_DB=fishsite
POSTGRES_USER=fishsite
POSTGRES_PASSWORD=replace-with-a-long-random-password

DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=false
# Add the Ubuntu VM's current IP before opening the site from your Mac.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Keep HTTP-friendly defaults for the local VM. Enable these only after HTTPS
# terminates at the controlled Nginx proxy on the VPS.
DJANGO_TRUST_X_FORWARDED_PROTO=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_DB_CONN_MAX_AGE=60
DJANGO_MEDIA_ROOT=/app/media
WEB_PORT=8000

# Yandex Maps JavaScript API v3 browser key; restrict domains in its dashboard.
YANDEX_MAPS_API_KEY=

# The worker profile needs valid SMTP credentials before it is started.
NOTIFICATION_BACKEND=integrations.notifications.smtp.SMTPNotificationBackend
NOTIFICATION_TO_EMAIL=
NOTIFICATION_FROM_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_ALLOW_INSECURE_LOCAL_AUTH=false
SMTP_TIMEOUT_SECONDS=10
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BASE_SECONDS=30
NOTIFICATION_RETRY_MAX_SECONDS=3600
NOTIFICATION_SCAN_INTERVAL_SECONDS=60
NOTIFICATION_LEASE_SECONDS=300
