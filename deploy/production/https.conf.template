user nginx;
worker_processes auto;
pid /var/run/nginx.pid;
# Request error logs can contain query strings or credential-bearing paths.
error_log /dev/null crit;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;
    client_max_body_size 10m;
    ssl_protocols TLSv1.2 TLSv1.3;
    log_format safe '$remote_addr [$time_local] $request_method $uri '
                    '$status $body_bytes_sent $request_time';
    map $uri $log_request {
        default 1;
        ~^/integrations/moysklad/webhooks(?:/|$) 0;
        ~^/(?:checkout|wholesale)/success(?:/|$) 0;
    }
    access_log /var/log/nginx/access.log safe if=$log_request;

    upstream fishsite_app {
        server web:8000;
    }

    proxy_http_version 1.1;
    proxy_set_header Host __DOMAIN__;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host __DOMAIN__;
    proxy_set_header Connection "";
    proxy_read_timeout 60s;

    server {
        listen 80 default_server;
        listen [::]:80 default_server;
        server_name _;
        access_log off;
        return 444;
    }

    server {
        listen 80;
        listen [::]:80;
        server_name __DOMAIN__;
        if ($host != __DOMAIN__) { return 444; }

        location ^~ /.well-known/acme-challenge/ {
            root /var/www/acme;
            default_type text/plain;
            limit_except GET { deny all; }
            try_files $uri =404;
        }

        location / {
            return 308 https://__DOMAIN__$request_uri;
        }
    }

    server {
        listen 443 ssl default_server;
        listen [::]:443 ssl default_server;
        server_name _;
        ssl_reject_handshake on;
        access_log off;
        return 444;
    }

    server {
        listen 443 ssl;
        listen [::]:443 ssl;
        server_name __DOMAIN__;
        ssl_certificate /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
        ssl_session_cache shared:SSL:10m;
        ssl_session_timeout 1d;
        ssl_session_tickets off;
        if ($host != __DOMAIN__) { return 444; }
        if ($ssl_server_name != __DOMAIN__) { return 444; }

        location /static/ {
            alias /usr/share/nginx/html/static/;
            limit_except GET { deny all; }
            add_header X-Content-Type-Options nosniff always;
        }

        location /media/ {
            alias /usr/share/nginx/html/media/;
            limit_except GET { deny all; }
            add_header X-Content-Type-Options nosniff always;
        }

        # The mounted URL configuration uses /two_factor/account/... .
        location ~ ^/(?:admin|account|two_factor)(?:/|$) {
            allow __OPERATOR_IP__;
            deny all;
            proxy_pass http://fishsite_app;
        }

        location ^~ /integrations/moysklad/webhooks/ {
            access_log off;
            error_log /dev/null crit;
            client_max_body_size 1m;
            proxy_read_timeout 2s;
            proxy_pass http://fishsite_app;
        }

        location / {
            proxy_pass http://fishsite_app;
        }
    }

    # Keep the SSH-tunnel acceptance route available after TLS activation.
    server {
        listen 8080 default_server;
        server_name _;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Connection "";

        location /static/ {
            alias /usr/share/nginx/html/static/;
            limit_except GET { deny all; }
            add_header X-Content-Type-Options nosniff always;
        }

        location /media/ {
            alias /usr/share/nginx/html/media/;
            limit_except GET { deny all; }
            add_header X-Content-Type-Options nosniff always;
        }

        location ^~ /integrations/moysklad/webhooks/ {
            access_log off;
            error_log /dev/null crit;
            client_max_body_size 1m;
            proxy_read_timeout 2s;
            proxy_pass http://fishsite_app;
        }

        location / {
            proxy_pass http://fishsite_app;
        }
    }
}
