# Локальная PostgreSQL для FishSite
DJANGO_DB_NAME=
DJANGO_DB_USER=
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=
DJANGO_DB_PORT=
DJANGO_DB_CONN_MAX_AGE=

# Yandex Maps JavaScript API v3 browser key; restrict domains in its dashboard.
YANDEX_MAPS_API_KEY=

# Notification delivery worker. Set real sender/destination and SMTP settings
# in the process environment; this example contains no credentials.
# Mail.ru: enable SMTP access and use the full mailbox address plus an
# external-application password. Mail.ru's SMTP profile uses implicit TLS.
NOTIFICATION_BACKEND=integrations.notifications.smtp.SMTPNotificationBackend
NOTIFICATION_TO_EMAIL=
NOTIFICATION_FROM_EMAIL=
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_USE_SSL=true
SMTP_ALLOW_INSECURE_LOCAL_AUTH=false
SMTP_TIMEOUT_SECONDS=10
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BASE_SECONDS=30
NOTIFICATION_RETRY_MAX_SECONDS=3600
NOTIFICATION_SCAN_INTERVAL_SECONDS=60
NOTIFICATION_LEASE_SECONDS=300

# МойСклад JSON API 1.2. Потоки выключены до проверки аккаунта и живой приёмки.
# UUID и namespace закрепляются за одним аккаунтом/окружением; токены только
# в серверном окружении. Admin token необязателен для отдельной команды регистрации; обычный worker не управляет вебхуками.
MOYSKLAD_ENVIRONMENT=development
MOYSKLAD_ACCOUNT_ID=
MOYSKLAD_NAMESPACE=
MOYSKLAD_API_TOKEN=
MOYSKLAD_ADMIN_TOKEN=
MOYSKLAD_PRICE_TYPE_ID=
MOYSKLAD_CURRENCY_ID=
MOYSKLAD_UNIT_ID=
MOYSKLAD_ORGANIZATION_ID=
MOYSKLAD_AGENT_ID=
MOYSKLAD_INITIAL_STATE_ID=
# UUID двух согласованных отложенных товаров, через запятую. Коды служат
# только для первоначального поиска; дальнейшие исключения определяются UUID.
MOYSKLAD_DEFERRED_PRODUCT_IDS=
MOYSKLAD_CATALOG_ENABLED=false
MOYSKLAD_PRICES_ENABLED=false
MOYSKLAD_EXPORT_ENABLED=false
MOYSKLAD_STATUSES_ENABLED=false
# Случайный secret: secrets.token_hex(32). Полный HTTPS URL включает этот secret
# в /integrations/moysklad/webhooks/prices/<secret>/. Не писать URL в логи.
MOYSKLAD_WEBHOOK_SECRET=
MOYSKLAD_WEBHOOK_URL=
